		  - 2023 - Systematic benchmarking of single-cell
		  ATAC-sequen.pdf}
}

@Article{	  dynanisolationtranscriptionfactors1983,
  title		= {Isolation of Transcription Factors That Discriminate
		  between Different Promoters Recognized by {{RNA}}
		  Polymerase {{II}}},
  author	= {Dynan, W. S. and Tjian, R.},
  date		= {1983-03},
  journaltitle	= {Cell},
  shortjournal	= {Cell},
  volume	= {32},
  number	= {3},
  eprint	= {6187469},
  eprinttype	= {pmid},
  pages		= {669--680},
  issn		= {0092-8674},
  doi		= {10.1016/0092-8674(83)90053-3},
  abstract	= {A new fractionation procedure separates a whole-cell HeLa
		  extract into three components required for accurate in
		  vitro transcription. One component (Sp1) is a
		  promoter-specific factor required for transcription of the
		  SV40 early and late promoters, but not for transcription of
		  other promoters we have tested. The second component (Sp2)
		  is a general factor required for transcription of the SV40
		  promoters and a series of others, including the adeno-virus
		  2 major late promoter, the human beta-globin promoter and
		  the avian sarcoma virus promoter. The third component is a
		  fraction containing the endogenous RNA polymerase II. When
		  SV40 and adenovirus templates were present simultaneously
		  in an in vitro transcription reaction, addition of the Sp1
		  factor stimulated SV40 early promoter transcription
		  40-fold, and inhibited adenovirus major late promoter
		  transcription by 40\%. This finding suggests that Sp1 is
		  involved in promoter selection, and is not merely a general
		  transcription stimulatory factor.},
  langid	= {english},
  keywords	= {DNA-Directed RNA Polymerases,Globins,HeLa
		  Cells,Humans,Nucleic Acid Hybridization,Operon,Poly
		  A,RNA,RNA Messenger,RNA Polymerase II,RNA Viral,Simian
		  virus 40,Transcription Factors,Transcription Genetic,Virus
		  Replication}
}

@Article{	  engelkespecificinteractionpurified1980,
  title		= {Specific Interaction of a Purified Transcription Factor
		  with an Internal Control Region of {{5S RNA}} Genes},
  author	= {Engelke, David R. and Ng, Sun-Yu and Shastry, B. S. and
		  Roeder, Robert G.},
  date		= {1980-03-01},
  journaltitle	= {Cell},
