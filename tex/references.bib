  eprinttype = {pmid},
  pages = {6628--6632},
  issn = {0027-8424},
  doi = {10.1073/pnas.78.11.6628},
  abstract = {Activated glucocorticoid receptor protein, purified to 40-60\% homogeneity from rat liver extracts, binds selectively in vitro to a cloned fragment of murine mammary tumor virus (MTV) DNA. The DNA fragment tested contains about half of the sequences present in intact MTV DNA, and its rate of transcription, like that of the intact viral element, is strongly stimulated by glucocorticoids when it is introduced into the genome of a receptor-containing cell. In contrast, the receptor fails to bind selectively to DNA restriction fragments from E. coli plasmids pBR322 and RSF2124 or from bacteriophages lambda and T4. Preliminary experiments to localize regions within MTV DNA responsible for selective binding have revealed thus far one subfragment that fails to bind the receptor and one selectively bound subfragment that maps far downstream from the 5' terminus of the normal RNA transcript. These studies are consistent with the notion that steroid receptors may modulate rates of transcription by recognizing specific DNA sequences within or near the regulated genes.},
  langid = {english},
  pmcid = {PMC349102},
  keywords = {Animals,Bacteriophage lambda,{Cloning, Molecular},DNA Restriction Enzymes,{DNA, Recombinant},{DNA, Viral},Glucocorticoids,Liver,{Mammary Tumor Virus, Mouse},Molecular Weight,Rats,{Receptors, Glucocorticoid},{Receptors, Steroid},{Transcription, Genetic},Triamcinolone Acetonide},
  file = {C\:\\Users\\u0117999\\Zotero\\storage\\XXJQLUPM\\Payvar et al. - 1981 - Purified glucocorticoid receptors bind selectively.pdf}
}

@article{preisslSinglenucleusAnalysisAccessible2018,
  title = {Single-Nucleus Analysis of Accessible Chromatin in Developing Mouse Forebrain Reveals Cell-Type-Specific Transcriptional Regulation},
  author = {Preissl, Sebastian and Fang, Rongxin and Huang, Hui and Zhao, Yuan and Raviram, Ramya and Gorkin, David U. and Zhang, Yanxiao and Sos, Brandon C. and Afzal, Veena and Dickel, Diane E. and Kuan, Samantha and Visel, Axel and Pennacchio, Len A. and Zhang, Kun and Ren, Bing},
  date = {2018-03},
  journaltitle = {Nat Neurosci},
  volume = {21},
  number = {3},
  eprint = {29434377},
  eprinttype = {pmid},
  pages = {432--439},
  issn = {1097-6256},
  doi = {10.1038/s41593-018-0079-3},
  url = {https://www.ncbi.nlm.nih.gov/pmc/articles/PMC5862073/},
  urldate = {2023-06-19},
  abstract = {Analysis of chromatin accessibility can reveal transcriptional regulatory sequences, but heterogeneity of primary tissues poses a significant challenge in mapping the precise chromatin landscape in specific cell types. Here we report single-nucleus ATAC-seq, a combinatorial barcoding-assisted single-cell assay for transposase-accessible chromatin that is optimized for use on flash-frozen primary tissue samples. We apply this technique to the mouse forebrain through eight developmental stages. Through analysis of more than 15,000 nuclei, we identify 20 distinct cell populations corresponding to major neuronal and non-neuronal cell types. We further define cell-type-specific transcriptional regulatory sequences, infer potential master transcriptional regulators and delineate developmental changes in forebrain cellular composition. Our results provide insight into the molecular and cellular dynamics that underlie forebrain development in the mouse and establish technical and analytical frameworks that are broadly applicable to other heterogeneous tissues.},
  pmcid = {PMC5862073},
  file = {C\:\\Users\\u0117999\\Zotero\\storage\\M93MU587\\Preissl et al. - 2018 - Single-nucleus analysis of accessible chromatin in.pdf}
}

