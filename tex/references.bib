		  and Wange, Lucas E. and Bagnoli, Johannes W. and Enard,
		  Wolfgang and Gut, Marta and Sandberg, Rickard and Nikaido,
		  Itoshi and Gut, Ivo and Stegle, Oliver and Heyn, Holger},
  date		= {2020-06},
  journaltitle	= {Nature Biotechnology},
  shortjournal	= {Nat Biotech},
  volume	= {38},
