		  f.pdf;/Users/florianderop/Zotero/storage/588V5NBL/S0092867480800481.html}
}

@Article{	  felsenfeldbriefhistoryepigenetics2014,
  title		= {A {{Brief History}} of {{Epigenetics}}},
  author	= {Felsenfeld, Gary},
  date		= {2014-01},
  journaltitle	= {Cold Spring Harbor Perspectives in Biology},
  shortjournal	= {CSH Persp Biol},
  volume	= {6},
