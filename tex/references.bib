@article{caoComprehensiveSinglecellTranscriptional2017,
  title = {Comprehensive Single-Cell Transcriptional Profiling of a Multicellular Organism},
  author = {Cao, Junyue and Packer, Jonathan S. and Ramani, Vijay and Cusanovich, Darren A. and Huynh, Chau and Daza, Riza and Qiu, Xiaojie and Lee, Choli and Furlan, Scott N. and Steemers, Frank J. and Adey, Andrew and Waterston, Robert H. and Trapnell, Cole and Shendure, Jay},
