  keywords = {Animals,Caenorhabditis elegans,Gene Expression Regulation,Multiplex Polymerase Chain Reaction,Reverse Transcriptase Polymerase Chain Reaction,{RNA, Helminth},{RNA, Messenger},{Sequence Analysis, DNA}},
